<Window x:Class="MatixMathClub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Matix — the Math Club"
        Height="900" Width="1400"
        MinHeight="560" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F7F7F9"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        RenderOptions.BitmapScalingMode="HighQuality"
        Icon="build/icon.ico">

    <!-- CaptionHeight=36 makes the top strip behave like a real Windows title
         bar: drag to move, double-click to maximise, drag to the top/side to
         snap. The buttons opt back out of that with IsHitTestVisibleInChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The icons used to come from the "Segoe MDL2 Assets" icon font. When
             that font is missing or blocked, Windows draws an empty box instead,
             which is the three squares in the screenshot. They are real vector
             shapes now, so they render on every machine with no font needed. -->
        <Style x:Key="TitleBarIcon" TargetType="Path">
            <Setter Property="Stroke"
                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- minimise / maximise -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#3A3A48" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="Transparent" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Fade the hover colour in and out instead of snapping. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#E6E6EE" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="Transparent" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- close: same, but turns red like every other Windows app -->
        <Style x:Key="CloseBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg">
                            <Border.Background>
                                <SolidColorBrush x:Name="BgBrush" Color="Transparent" />
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="White" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#E81123" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BgBrush"
                                                            Storyboard.TargetProperty="Color"
                                                            To="Transparent" Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== custom title bar ===== -->
        <Border Grid.Row="0" Visibility="Collapsed" Background="White"
                BorderBrush="#E6E6EE" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="build/icon.ico"
                       Width="18" Height="18" Margin="10,0,8,0"
                       VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Text="Matix — the Math Club"
                           FontSize="12" FontWeight="SemiBold" Foreground="#283F71"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="MinBtn"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Minimise"
                            Click="MinBtn_Click">
                        <Path Style="{StaticResource TitleBarIcon}" Data="M 0,0 H 10" />
                    </Button>
                    <Button x:Name="MaxBtn"
                            Style="{StaticResource TitleBarButton}"
                            ToolTip="Maximise"
                            Click="MaxBtn_Click">
                        <Path x:Name="MaxIcon" Style="{StaticResource TitleBarIcon}"
                              Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" />
                    </Button>
                    <Button x:Name="CloseBtn"
                            Style="{StaticResource CloseBarButton}"
                            ToolTip="Close"
                            Click="CloseBtn_Click">
                        <Path Style="{StaticResource TitleBarIcon}"
                              Data="M 0,0 L 10,10 M 10,0 L 0,10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== app content ===== -->
        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="Web" Visibility="Collapsed" />

            <Border x:Name="Splash" Background="#F7F7F9">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="build/icon.ico" Width="84" Height="84" Margin="0,0,0,18" />
                    <TextBlock Text="Matix"
                               FontSize="26" FontWeight="Bold" Foreground="#283F71"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="the Math Club"
                               FontSize="13" Foreground="#8A8A99"
                               HorizontalAlignment="Center" Margin="0,2,0,20" />
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                                 Foreground="#5B46C9" Background="#E6E6EE"
                                 BorderThickness="0" />
                    <TextBlock x:Name="SplashText" Text="Starting up..."
                               FontSize="12" Foreground="#8A8A99"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Background="#F7F7F9" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="560" Margin="30">
                    <TextBlock Text="!" FontSize="40" FontWeight="Bold" Foreground="#F7A600"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="Matix couldn't start"
                               FontSize="20" FontWeight="Bold" Foreground="#283F71"
                               HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock x:Name="ErrorText"
                               FontSize="13" Foreground="#5A5A6B"
                               TextWrapping="Wrap" TextAlignment="Center" />
                    <Button x:Name="RetryButton" Content="Try again"
                            Click="RetryButton_Click"
                            Width="130" Height="36" Margin="0,22,0,0"
                            Background="#5B46C9" Foreground="White"
                            BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
