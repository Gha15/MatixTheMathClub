{
  "name": "matix",
  "productName": "Matix",
  "version": "1.0.0",
  "description": "Matix — the Math Club workspace",
  "author": "Matix the Math Club",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist": "electron-builder -mw"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.matix.mathclub",
    "productName": "Matix",
    "copyright": "Copyright © Matix the Math Club",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "artifactName": "matix-installer.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Matix",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "matix-installer.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.education",
      "artifactName": "matix-installer.${ext}"
    },
    "dmg": {
      "title": "Install Matix",
      "artifactName": "matix-installer.${ext}"
    }
  }
}
